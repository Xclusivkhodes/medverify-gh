# true (default): never call Nebius or Tavily. Use the bundled snapshot.
# auto: live only when both API keys are set.
# false: always live. The API returns 503 if a key is missing.
# Leave this as true unless you intend to spend credits.
DEMO_MODE=true

# Extra kill switch. false forces demo even if DEMO_MODE is false.
# Turn it on only after you accept the API budget.
LLM_ENABLED=false

# Optional pause between demo steps, in milliseconds. Use 0 for instant demo checks.
DEMO_PACE_MS=280

# Per-call output cap, and a budget for one pack check (prompt + completion).
# Super and Ultra spend the cap on reasoning before content is written.
NEBIUS_MAX_TOKENS=512
NEBIUS_REQUEST_TOKEN_BUDGET=2048

# Nebius Token Factory. Create a key at https://tokenfactory.nebius.com/
# Do not set this during development or tests. Demo mode does not need it.
NEBIUS_API_KEY=

# OpenAI-compatible base URL.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# NVIDIA models on that endpoint. Text defaults are Nano. Vision is VL.
# Ultra is rejected on the live path even if you paste its id here.
NEBIUS_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL
NEBIUS_NORMALIZE_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_VERDICT_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Opt-in verdict escalation only. It spends the token cap on reasoning_content first:
# nvidia/nemotron-3-super-120b-a12b

# Tavily Search. https://tavily.com
# Do not set this during development or tests.
TAVILY_API_KEY=

# Public site URL used for Open Graph links. Optional in local demo.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123

# When the UI is hosted apart from the API, set this to the API origin (no trailing slash).
# Leave empty for same-origin /api routes.
NEXT_PUBLIC_API_BASE=

# Comma-separated browser origins allowed to call the API. Empty means same-origin only.
CORS_ORIGINS=

# In-memory rate limit for POST /api/verify. Demo checks count too.
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_GLOBAL_PER_MINUTE=120

# Live-call guards. The dollar figure is a high estimate, not a Nebius invoice.
BUDGET_USD=1
BUDGET_SOFT_RATIO=0.7
BUDGET_HARD_RATIO=0.9
LIVE_CONCURRENCY=2
